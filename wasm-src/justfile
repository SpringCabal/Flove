set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp target/wasm32-unknown-unknown/release/flove_jobs_wasm.wasm ../LuaRules/wasm/flove-jobs.wasm
    mkdir -p ../LuaRules/wasm ../LuaUI/wasm
    cp target/wasm32-unknown-unknown/release/flove_rules_wasm.wasm ../LuaRules/wasm/flove-rules.wasm
    cp target/wasm32-unknown-unknown/release/flove_ui_wasm.wasm ../LuaUI/wasm/flove-ui.wasm

# Host tests of the crate the rules and UI share.
test:
    cargo test -p flove-shared --target "$(rustc -vV | sed -n 's/^host: //p')"
